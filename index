<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ten Questions</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Literata:opsz,wght@7..72,400;7..72,600&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --paper:#EEF1F7; --card:#FFFFFF; --ink:#14213D; --muted:#5B6783; --line:#CFD6E4;
  --blue:#2F5BEA; --blue-ink:#FFFFFF; --good:#17794C; --good-bg:#DDF3E8;
  --bad:#B5303F; --bad-bg:#FADFE2; --mark:#FFD54A; --ring:#B9C4DC;
  --display:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",sans-serif;
  --serif:"Literata",Georgia,"Times New Roman",serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#0E1424; --card:#18203A; --ink:#E8ECF7; --muted:#9AA6C4; --line:#2B3658;
    --blue:#6D8DFF; --blue-ink:#0E1424; --good:#5FD39A; --good-bg:#12372A;
    --bad:#FF8A98; --bad-bg:#4A1D26; --mark:#FFD54A; --ring:#34406A;
  }
}
:root[data-theme="dark"]{
  --paper:#0E1424; --card:#18203A; --ink:#E8ECF7; --muted:#9AA6C4; --line:#2B3658;
  --blue:#6D8DFF; --blue-ink:#0E1424; --good:#5FD39A; --good-bg:#12372A;
  --bad:#FF8A98; --bad-bg:#4A1D26; --mark:#FFD54A; --ring:#34406A;
}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;min-height:100%;background:var(--paper);color:var(--ink);font-family:var(--serif);font-size:17px;line-height:1.55}
main{max-width:640px;margin:0 auto;padding:20px 18px 48px}
h1,h2,h3,.display{font-family:var(--display);letter-spacing:-0.01em;margin:0}
.brand{font-family:var(--display);font-weight:800;font-size:1.05rem;display:flex;align-items:center;gap:8px;margin-bottom:22px}
.brand i{display:inline-block;width:22px;height:22px;border-radius:50%;border:3px solid var(--ink);position:relative}
.brand i::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--mark)}
h1{font-size:clamp(2rem,8vw,2.8rem);line-height:1.05;font-weight:800;margin-bottom:10px}
.lede{color:var(--muted);margin:0 0 26px;max-width:46ch}
label,.fieldlabel{display:block;font-family:var(--display);font-weight:700;font-size:.98rem;margin:0 0 6px}
.hint{font-size:.88rem;color:var(--muted);margin:6px 0 0}
input[type=text],textarea{width:100%;font:inherit;color:var(--ink);background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:12px 14px}
textarea{min-height:110px;resize:vertical}
input[type=text]:focus-visible,textarea:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.field{margin-bottom:24px}

/* depth meter */
.meter{display:flex;gap:5px;margin-top:10px}
.meter span{flex:1;height:7px;border-radius:4px;background:var(--line);transition:background .25s}
.meter span.on{background:var(--blue)}
.depthline{display:flex;justify-content:space-between;gap:10px;font-size:.88rem;margin-top:6px}
.depthline b{font-family:var(--display)}
.depthline span{color:var(--muted);text-align:right}

/* dial */
.dialwrap{display:grid;grid-template-columns:minmax(0,200px) 1fr;gap:18px;align-items:center}
@media (max-width:420px){.dialwrap{grid-template-columns:1fr}}
.dial{width:100%;max-width:220px;margin:0 auto;display:block}
.dial .ringline{fill:none;stroke:var(--ring);stroke-width:1;stroke-dasharray:3 4}
.dial .zone{fill:var(--blue);opacity:.13;transform-box:fill-box;transform-origin:center;transition:transform .45s cubic-bezier(.3,.8,.3,1)}
.dial .pt{fill:var(--blue);transition:transform .45s cubic-bezier(.3,.8,.3,1)}
.dial .core{fill:var(--mark);stroke:var(--ink);stroke-width:2.5}
.levels{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.levels button{font:700 1rem var(--display);padding:12px 0;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
.levels button[aria-pressed=true]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.levelname{margin:12px 0 2px;font-family:var(--display);font-weight:700}
.leveldesc{margin:0;color:var(--muted);font-size:.92rem}

/* buttons */
.btn{font:700 1.02rem var(--display);padding:14px 20px;border-radius:12px;border:0;background:var(--blue);color:var(--blue-ink);cursor:pointer;width:100%}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.row{display:grid;gap:10px;margin-top:18px}
.err{background:var(--bad-bg);color:var(--bad);border-radius:10px;padding:12px 14px;margin-top:16px;font-size:.95rem}

/* loading */
.loadbox{padding:40px 0;text-align:center}
.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin:18px 0 10px}
.bar>div{height:100%;width:6%;background:var(--blue);border-radius:4px;transition:width .4s}
.pulse{display:inline-block;width:12px;height:12px;border-radius:50%;background:var(--mark);animation:pulse 1.1s infinite ease-in-out}
@keyframes pulse{0%,100%{transform:scale(.6)}50%{transform:scale(1.2)}}

/* quiz */
.progress{display:flex;gap:4px;margin-bottom:18px}
.progress span{flex:1;height:8px;border-radius:4px;background:var(--line)}
.progress .ok{background:var(--good)} .progress .no{background:var(--bad)} .progress .cur{background:var(--blue)}
.qmeta{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:.88rem;margin-bottom:10px}
.qtext{font-family:var(--serif);font-weight:600;font-size:1.28rem;line-height:1.4;margin:0 0 20px;outline:none}
.opts{display:grid;gap:10px;padding:0;margin:0;list-style:none}
.opt{width:100%;display:grid;grid-template-columns:30px 1fr;gap:10px;text-align:left;font:inherit;color:var(--ink);background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:13px 14px;cursor:pointer}
.opt b{font-family:var(--display);width:26px;height:26px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;font-size:.85rem}
.opt:not(:disabled):hover{border-color:var(--blue)}
.opt:disabled{cursor:default}
.opt.right{background:var(--good-bg);border-color:var(--good)}
.opt.right b{background:var(--good);border-color:var(--good);color:var(--paper)}
.opt.wrong{background:var(--bad-bg);border-color:var(--bad)}
.opt.wrong b{background:var(--bad);border-color:var(--bad);color:var(--paper)}
.explain{margin-top:16px;padding:14px 16px;border-left:5px solid var(--mark);background:var(--card);border-radius:0 12px 12px 0;font-size:.97rem}
.explain strong{font-family:var(--display)}

/* result */
.score{font-family:var(--display);font-weight:800;font-size:clamp(3.4rem,18vw,5.4rem);line-height:1}
.score small{font-size:.4em;color:var(--muted);font-weight:700}
details.rv{background:var(--card);border:1.5px solid var(--line);border-radius:12px;margin-top:10px}
details.rv summary{cursor:pointer;padding:12px 14px;list-style:none;display:grid;grid-template-columns:26px 1fr;gap:10px;font-size:.98rem}
details.rv summary::-webkit-details-marker{display:none}
.mk{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font:800 .75rem var(--display);color:var(--paper)}
.mk.ok{background:var(--good)} .mk.no{background:var(--bad)}
.rvbody{padding:0 14px 14px 50px;font-size:.95rem}
.rvbody p{margin:6px 0}
.hidden{display:none!important}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<main>
  <div class="brand"><i></i>Ten Questions</div>

  <section id="setup">
    <h1>Quiz me on anything.</h1>
    <p class="lede">Name a topic, say how deep you want to go, and pick how far the questions may wander. You get ten new questions every time.</p>

    <div class="field">
      <label for="topic">Topic</label>
      <input id="topic" type="text" maxlength="120" placeholder="e.g. Operating system scheduling" autocomplete="off">
    </div>

    <div class="field">
      <label for="desc">Describe what you want covered</label>
      <textarea id="desc" maxlength="1500" placeholder="The more specific you are, the harder the questions. Name sub-topics, algorithms, formulas, time periods, or the exam you are preparing for."></textarea>
      <div class="meter" id="meter" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <div class="depthline" aria-live="polite"><b id="depthname">Introductory</b><span id="depthhint"></span></div>
    </div>

    <div class="field">
      <div class="fieldlabel" id="lvl-label">How far can questions stray?</div>
      <div class="dialwrap">
        <svg class="dial" viewBox="0 0 200 200" role="img" aria-label="Diagram: questions spread wider as the level increases">
          <circle class="ringline" cx="100" cy="100" r="40"/>
          <circle class="ringline" cx="100" cy="100" r="54"/>
          <circle class="ringline" cx="100" cy="100" r="68"/>
          <circle class="ringline" cx="100" cy="100" r="82"/>
          <circle class="ringline" cx="100" cy="100" r="96"/>
          <circle class="zone" id="zone" cx="100" cy="100" r="96"/>
          <g id="pts"></g>
          <circle class="core" cx="100" cy="100" r="9"/>
        </svg>
        <div>
          <div class="levels" role="group" aria-labelledby="lvl-label" id="levels"></div>
          <p class="levelname" id="lvname"></p>
          <p class="leveldesc" id="lvdesc"></p>
        </div>
      </div>
    </div>

    <button class="btn" id="go">Generate 10 questions</button>
    <div id="seterr" class="err hidden" role="alert"></div>
  </section>

  <section id="loading" class="hidden" aria-live="polite">
    <div class="loadbox">
      <span class="pulse"></span>
      <h2 style="margin-top:14px" id="loadtitle">Thinking...</h2>
      <div class="bar"><div id="loadbar"></div></div>
      <p class="hint" id="loadsub">Writing your questions</p>
      <div class="row" style="max-width:240px;margin:22px auto 0"><button class="btn ghost" id="stop">Stop</button></div>
    </div>
  </section>

  <section id="quiz" class="hidden">
    <div class="progress" id="progress" aria-hidden="true"></div>
    <div class="qmeta"><span id="qcount"></span><span id="qarea"></span></div>
    <h2 class="qtext" id="qtext" tabindex="-1"></h2>
    <ul class="opts" id="opts"></ul>
    <div id="explain" class="explain hidden" aria-live="polite"></div>
    <div class="row"><button class="btn hidden" id="next">Next question</button></div>
  </section>

  <section id="result" class="hidden">
    <div class="score" id="score"></div>
    <h1 id="verdict" style="font-size:1.6rem;margin:10px 0 4px"></h1>
    <p class="lede" id="rsub" style="margin-bottom:18px"></p>
    <div id="review"></div>
    <div class="row">
      <button class="btn" id="again">New quiz, same settings</button>
      <button class="btn ghost" id="change">Change topic or level</button>
    </div>
  </section>
</main>

<script>
